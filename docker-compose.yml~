# Sobe o PostgreSQL com as mesmas credenciais do application.properties.
#   docker compose up -d db        → só o banco (rode a API pela IDE / ./mvnw spring-boot:run)
#   docker compose up -d --build   → banco + API
services:
  db:
    image: postgres:16-alpine
    environment:
      POSTGRES_DB: quickstock
      POSTGRES_USER: postgres
      POSTGRES_PASSWORD: admin
    ports:
      - "5432:5432"
    volumes:
      - pgdata:/var/lib/postgresql/data
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U postgres -d quickstock"]
      interval: 5s
      timeout: 3s
      retries: 10

  api:
    build: .
    depends_on:
      db:
        condition: service_healthy
    environment:
      DB_URL: jdbc:postgresql://db:5432/quickstock
      DB_USERNAME: postgres
      DB_PASSWORD: admin
      JWT_SECRET: ${JWT_SECRET:-QuickStockDevSecretKey2026Minimo32Chars!!}
    ports:
      - "8081:8081"
    volumes:
      - ./uploads:/app/uploads

volumes:
  pgdata:
